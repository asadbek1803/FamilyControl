# MAHALLIY ISHLASH uchun. Railway'ga bu faylni YUKLAMANG — u Railway
# "Variables" orqali qo'yiladi. `.env` `.gitignore` da, shuning uchun
# GitHub'ga tasodifan tushmaydi.

# @BotFather orqali olgan tokenni shu yerga yozing.
# Eslatma: eski token (8887166286:AAH47...) allaqach oshkor bo'lgan —
# avval uni @BotFather orqali /revoke qilib, yangisini oling.
TELEGRAM_BOT_TOKEN=

# PostgreSQL (Neon) ulanish manzili. Railway'da "Variables" orqali qo'yiladi.
# Bo'sh qoldirilsa SQLite ishlatiladi (faqat mahalliy tez sinash uchun).
#
# Neon -> Connection Details -> "Pooled connection" ( `-pooler.` bilan
# tugaydani) nusxalang. `?sslmode=require&channel_binding=require` qismini
# O'CHIRMAY qo'ying — kod ularni to'g'ri uzatadi.
DATABASE_URL=

# Django maxfiy kaliti. Production'da ham shuni almashtiring.
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True